[user]
	email = brandondong96@gmail.com
	name = Brandon
[core]
	editor = msedit
	autocrlf = input
	pager = delta
	hooksPath = ~/.git-hooks
	# See https://github.blog/engineering/infrastructure/improve-git-monorepo-performance-with-a-file-system-monitor.
	fsmonitor = true
	untrackedcache = true
[pull]
	ff = only
[merge]
	conflictstyle = diff3
[branch]
	autoSetupMerge = simple
[advice]
	defaultBranchName = false
	diverging = false

# Delta settings:
[interactive]
	diffFilter = delta --color-only
[delta]
	line-numbers = true
	navigate = true
	side-by-side = true
	# Force line wrapping and left-aligned.
	wrap-max-lines = unlimited
	wrap-right-percent = 0.01
	wrap-left-symbol = " "
	# Try to use terminal colors for everything except highlighted line backgrounds.
	syntax-theme = gruvbox-dark
	line-numbers-plus-style = brightgreen
	line-numbers-minus-style = brightred
	line-numbers-zero-style = brightblack
	file-added-label = [+]
	file-copied-label = [==]
	file-modified-label = [*]
	file-removed-label = [-]
	file-renamed-label = [->]
[diff]
	colorMoved = default
